{
  "name": "@tradejs/strategy-kit",
  "version": "3.0.3",
  "description": "MIT-licensed browser-safe helpers for independently packaged TradeJS strategies.",
  "type": "module",
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "tradejs",
    "trading",
    "strategy",
    "plugin",
    "risk-management",
    "backtesting",
    "crypto",
    "bybit",
    "binance",
    "coinbase",
    "ai",
    "claude",
    "codex"
  ],
  "homepage": "https://tradejs.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/TradeJS-Dev/TradeJS-Strategy-Kit"
  },
  "bugs": {
    "url": "https://github.com/TradeJS-Dev/TradeJS-Strategy-Kit/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./ai-gate": {
      "types": "./dist/ai-gate.d.ts",
      "import": "./dist/ai-gate.js",
      "require": "./dist/ai-gate.cjs"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./figures": {
      "types": "./dist/figures.d.ts",
      "import": "./dist/figures.js",
      "require": "./dist/figures.cjs"
    },
    "./numbers": {
      "types": "./dist/numbers.d.ts",
      "import": "./dist/numbers.js",
      "require": "./dist/numbers.cjs"
    },
    "./positions": {
      "types": "./dist/positions.d.ts",
      "import": "./dist/positions.js",
      "require": "./dist/positions.cjs"
    },
    "./risk": {
      "types": "./dist/risk.d.ts",
      "import": "./dist/risk.js",
      "require": "./dist/risk.cjs"
    },
    "./state": {
      "types": "./dist/state.d.ts",
      "import": "./dist/state.js",
      "require": "./dist/state.cjs"
    }
  },
  "sideEffects": false,
  "devDependencies": {
    "@tradejs/core": "^3.0.1",
    "@tradejs/types": "^3.0.1",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "scripts": {
    "build": "tsup",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "typecheck": "tsc -p ./tsconfig.json --noEmit",
    "checks": "yarn format:check && yarn typecheck && yarn test && yarn build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "license": "MIT",
  "author": "aleksnick (https://github.com/aleksnick)",
  "peerDependencies": {
    "@tradejs/core": "^3.0.1",
    "@tradejs/types": "^3.0.1"
  }
}
